<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Фаза 2 плана (пункты 2.1/2.2): ядро продукта (модели + генерация G-кода +
    базовая локализация) вынесено из WPF-сборки в отдельную класс-библиотеку.
    - TFM: net10.0 без привязки к платформе. Прежде стоял net10.0-windows —
      «как у приложения», хотя кода, требующего Windows, здесь нет: суффикс
      лишь помечал сборку как windows-only и тем самым закрывал ядру дорогу
      в консольные сценарии, на сервер и на другие системы, о которых
      говорит README. Смена TFM не потребовала ни одной правки кода:
      зависимости (Clipper2, netDxf, CommunityToolkit.Mvvm) собраны под
      netstandard2.0 и от платформы не зависят.
    - Неймспейсы сохранены (GCodeGenerator.Models, GCodeGenerator.GCodeGenerators.*,
      GCodeGenerator.Localization) — код приложения и тестов не меняется;
      переименование неймспейсов — отдельный шаг (в данный пункт не входит).
    - Зависимости: BCL (в том числе System.Text.Json — файл проекта и
      копирование операций) и Clipper2 — построение эквидистант контуров.
      Собственная реализация смещения не удаляла петли самопересечения,
      и её результат приходилось распознавать эвристиками.
    - Чтение и запись файла проекта (.ygc) живут здесь же (Persistence):
      формат описывает доменные операции, поэтому открыть проект можно
      без сборки приложения — это условие и для консольных сценариев,
      и для смены интерфейсного стека.
    - InternalsVisibleTo не требуется: в перенесённых файлах нет internal-членов.
    - AppSettingsStore (Properties.Settings) остаётся в App — это инфраструктура
      пользовательских настроек, а не доменная модель.
    - GenerateTargetPlatformAttribute/GenerateSupportedOSPlatformAttribute=false:
      SDK для net10.0-windows по умолчанию генерирует
      [assembly: SupportedOSPlatform("Windows7.0")], а в App/Tests (ручной
      AssemblyInfo.cs, GenerateAssemblyInfo=false) таких атрибутов нет —
      рассогласование вызывало тысячи предупреждений CA1416 в App/Tests.
      Код Core — чистый BCL (кроссплатформенный), поэтому аннотация
      «только Windows» здесь не нужна.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GCodeGenerator.Core</RootNamespace>
    <AssemblyName>GCodeGenerator.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <!-- Ядро публикуется в составе приложения, поэтому среда выполнения
         объявляется и здесь: восстановление под win-x64 идёт по всему дереву
         ссылок, и замок ядра обязан покрывать тот же набор сред, что и замок
         приложения. Множественное число намеренно — набор сред для
         восстановления пакетов, а не привязка сборки к одной из них: ядро
         остаётся кроссплатформенным (TFM net10.0, см. выше).
         Подробнее — GCodeGenerator.csproj, RuntimeIdentifiers. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Разбор чертежа состоит из шагов, каждый из которых проверяется
         отдельно: поиск замкнутых циклов, разрезание пересечений,
         соединение отрезков. Наружу они не выходят, но тестам видны. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GCodeGenerator.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GCodeGenerator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <!-- Чтение чертежей — часть ядра: восстановление контуров из DXF
         не зависит от интерфейса и нужно любому потребителю моделей. -->
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <!-- Уведомления об изменении параметров операции. Пакет не зависит от WPF
         (netstandard2.0) и даёт генератор свойств: иначе сто с лишним
         параметров пришлось бы расписывать сеттерами вручную, а забытый
         параметр молча переставал бы обновлять предпросмотр. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
