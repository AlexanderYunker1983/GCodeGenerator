<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style (пункт 1.1 плана); TFM net10.0-windows (пункт 1.5 плана, D5) —
    обязан совпадать с TFM основного проекта (ProjectReference).
    - GenerateAssemblyInfo=false: свойства сборки объявлены вручную в Properties/AssemblyInfo.cs.
    - LangVersion=latest: как до миграции (в старом csproj LangVersion не задан).
    - Явная ссылка на MSTest.TestAdapter из старого csproj (обходной путь для packages.config)
      больше не нужна: PackageReference + Microsoft.NET.Test.Sdk корректно размещают
      адаптер в каталоге сборки для dotnet vstest.
    - MugenMvvmToolkit убран (пункт 1.5): после 1.3 тесты его не используют
      (CloseableViewModel — собственный класс в GCodeGenerator.Infrastructure).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GCodeGenerator.Tests</RootNamespace>
    <AssemblyName>GCodeGenerator.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <WarningLevel>4</WarningLevel>
    <IsPackable>false</IsPackable>
    <!-- Классическая раскладка bin\Release (без подпапки TFM): CI ищет bin\Release\GCodeGenerator.Tests.dll -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Пункт 1.5: 18.x — поддержка net10.0 (17.8.0 — эпохи net481/net8). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCodeGenerator\GCodeGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.dxf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Golden\*.nc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reference\reference_project.ygc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Пункт 1.2: эталонный легаси-файл v1 (формат JavaScriptSerializer) для тестов легаси-ридера. -->
    <None Include="Reference\legacy_project_v1.ygc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reference\reference_project.nc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
