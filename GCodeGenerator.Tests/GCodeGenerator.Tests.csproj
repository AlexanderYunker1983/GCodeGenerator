<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style (пункт 1.1 плана): TFM пока net481, переключение на net10.0-windows — пункт 1.5.
    - GenerateAssemblyInfo=false: свойства сборки объявлены вручную в Properties/AssemblyInfo.cs.
    - LangVersion=latest: как до миграции (в старом csproj LangVersion не задан).
    - Явная ссылка на MSTest.TestAdapter из старого csproj (обходной путь для packages.config)
      больше не нужна: PackageReference + Microsoft.NET.Test.Sdk корректно размещают
      адаптер в каталоге сборки для dotnet vstest.
  -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>GCodeGenerator.Tests</RootNamespace>
    <AssemblyName>GCodeGenerator.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <WarningLevel>4</WarningLevel>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Классическая раскладка bin\Release (без подпапки TFM): CI ищет bin\Release\GCodeGenerator.Tests.dll -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <!-- Базовый класс VM (CloseableViewModel) для загрузки DXF-фикстур через реальные парсеры. -->
    <PackageReference Include="MugenMvvmToolkit" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCodeGenerator\GCodeGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.dxf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Golden\*.nc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reference\reference_project.ygc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reference\reference_project.nc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
