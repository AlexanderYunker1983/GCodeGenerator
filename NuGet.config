<?xml version="1.0" encoding="utf-8"?>
<!--
  Пункт 1.4: репозиторный NuGet.config.
  - "unified" — локальное ProGet-зеркало (основной источник; совпадает с пользовательским профилем).
  - "nuget.org" — фолбэк: MahApps.Metro 2.x отсутствует в зеркале (404), доступен только с nuget.org.
  <clear/> намеренно не используется, чтобы не отключать остальные источники пользователя.
-->
<configuration>
  <packageSources>
    <add key="unified" value="http://localhost:8624/nuget/unified/v3/index.json" protocolVersion="3" allowInsecureConnections="True" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
