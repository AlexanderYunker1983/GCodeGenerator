<Window x:Class="GCodeGenerator.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:GCodeGenerator.Infrastructure"
        xmlns:loc="clr-namespace:GCodeGenerator.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GCodeGenerator.ViewModels"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
        Title="{loc:Loc GCodeSettingsTitle}"
        WindowStartupLocation="CenterOwner"
        Width="640" Height="600"
        MinWidth="560" MinHeight="360">
    <DockPanel>
        <!-- Явные OK/Cancel: сохраняет OK, отмена и крестик оставляют настройки прежними.
             «Сделать умолчаниями» записывает значения окна как умолчания генерации
             для новых проектов, не трогая открытый документ. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="#D13438"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="{loc:Loc SaveAsDefaults}"
                        ToolTip="{loc:Loc SaveAsDefaultsToolTip}"
                        Command="{Binding SaveAsDefaultsCommand}"
                        MinWidth="120"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Ok}" Command="{Binding OkCommand}" IsDefault="True" MinWidth="80" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <mah:MetroTabControl Margin="8">
            <!-- MahApps 2.x: mah:MetroTabItem вместо TabItem (стиль MetroTabItem типизирован под MetroTabItem). -->
            <mah:MetroTabItem Header="{loc:Loc CodeGenerationSettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox
                            Content="{loc:Loc UseLineNumbers}"
                            IsChecked="{Binding UseLineNumbers}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="{loc:Loc LineNumberStart}" Width="180" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding LineNumberStart, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Integer"/>
                    </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="{loc:Loc LineNumberStep}" Width="180" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding LineNumberStep, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Integer"/>
                    </StackPanel>

                        <CheckBox Margin="0,8,0,0"
                                  Content="{loc:Loc GenerateComments}"
                                  IsChecked="{Binding UseComments}"/>

                        <CheckBox Margin="0,8,0,0"
                                  Content="{loc:Loc AllowArcs}"
                                  IsChecked="{Binding AllowArcs}"/>

                        <CheckBox Margin="0,8,0,0"
                                  Content="{loc:Loc UsePaddedGCodes}"
                                  IsChecked="{Binding UsePaddedGCodes}"/>

                        <!-- Стойка, для которой строится программа: показывается
                             название, сохраняется ключ (единицы паузы G4 у стоек разные). -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="{loc:Loc PostProcessor}" Width="180" VerticalAlignment="Center"/>
                            <ComboBox Width="220"
                                      Style="{StaticResource MahApps.Styles.ComboBox}"
                                      ItemsSource="{Binding PostProcessors}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding PostProcessorName}"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,8"/>

                        <!-- Рабочая система координат (G54-G59) -->
                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc SetWorkCoordinateSystem}"
                                  IsChecked="{Binding SetWorkCoordinateSystem}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                                    IsEnabled="{Binding SetWorkCoordinateSystem}">
                            <Label Content="{loc:Loc WorkCoordinateSystem}" Width="180" VerticalAlignment="Center"/>
                            <ComboBox Width="100"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding WorkCoordinateSystem}"
                                      Style="{StaticResource MahApps.Styles.ComboBox}">
                                <ComboBoxItem Content="G54"/>
                                <ComboBoxItem Content="G55"/>
                                <ComboBoxItem Content="G56"/>
                                <ComboBoxItem Content="G57"/>
                                <ComboBoxItem Content="G58"/>
                                <ComboBoxItem Content="G59"/>
                            </ComboBox>
                    </StackPanel>

                        <Separator Margin="0,12,0,8"/>

                        <!-- Начальная позиция (G92) -->
                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc AddStartPosition}"
                                  IsChecked="{Binding AddStartPosition}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                                    IsEnabled="{Binding AddStartPosition}">
                            <Label Content="{loc:Loc StartPositionX}" Width="60" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding StartX, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Content="{loc:Loc StartPositionY}" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding StartY, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Content="{loc:Loc StartPositionZ}" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding StartZ, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                    </StackPanel>

                        <!-- Конечная позиция (G0) -->
                        <CheckBox Margin="0,8,0,4"
                                  Content="{loc:Loc AddEndPosition}"
                                  IsChecked="{Binding AddEndPosition}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                                    IsEnabled="{Binding AddEndPosition}">
                            <Label Content="{loc:Loc EndPositionX}" Width="60" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding EndX, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Content="{loc:Loc EndPositionY}" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding EndY, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Content="{loc:Loc EndPositionZ}" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Width="80"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding EndZ, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="{loc:Loc SpindleSettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox
                            Content="{loc:Loc SpindleControlEnabled}"
                            IsChecked="{Binding SpindleControlEnabled}"/>

                        <Separator Margin="0,8,0,8"/>

                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc SpindleSpeedEnabled}"
                                  IsChecked="{Binding SpindleSpeedEnabled}"
                                  IsEnabled="{Binding SpindleControlEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,8"
                                    IsEnabled="{Binding SpindleControlEnabled}">
                            <Label Content="{loc:Loc SpindleSpeedRpm}" Width="200" VerticalAlignment="Center"/>
                            <TextBox Width="100"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding SpindleSpeedRpm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Integer"/>
                    </StackPanel>

                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc SpindleStartEnabled}"
                                  IsChecked="{Binding SpindleStartEnabled}"
                                  IsEnabled="{Binding SpindleControlEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,8"
                                    IsEnabled="{Binding SpindleControlEnabled}">
                            <Label Content="{loc:Loc SpindleStartCommand}" Width="200" VerticalAlignment="Center"/>
                            <ComboBox Width="100"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding SpindleStartCommand}"
                                      Style="{StaticResource MahApps.Styles.ComboBox}">
                                <ComboBoxItem Content="M3"/>
                                <ComboBoxItem Content="M4"/>
                            </ComboBox>
                    </StackPanel>

                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc SpindleStopEnabled}"
                                  IsChecked="{Binding SpindleStopEnabled}"
                                  IsEnabled="{Binding SpindleControlEnabled}"/>

                        <CheckBox Margin="12,8,0,4"
                                  Content="{loc:Loc SpindleDelayEnabled}"
                                  IsChecked="{Binding SpindleDelayEnabled}"
                                  IsEnabled="{Binding SpindleControlEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="36,0,0,0"
                                    IsEnabled="{Binding SpindleControlEnabled}">
                            <Label Content="{loc:Loc SpindleDelaySeconds}" Width="200" VerticalAlignment="Center"/>
                            <TextBox Width="100"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding SpindleDelaySeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="{loc:Loc CoolantSettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox
                            Content="{loc:Loc CoolantControlEnabled}"
                            IsChecked="{Binding CoolantControlEnabled}"/>

                        <Separator Margin="0,8,0,8"/>

                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc CoolantStartEnabled}"
                                  IsChecked="{Binding CoolantStartEnabled}"
                                  IsEnabled="{Binding CoolantControlEnabled}"/>

                        <CheckBox Margin="0,0,0,4"
                                  Content="{loc:Loc CoolantStopEnabled}"
                                  IsChecked="{Binding CoolantStopEnabled}"
                                  IsEnabled="{Binding CoolantControlEnabled}"/>
                    </StackPanel>
                </ScrollViewer>
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="{loc:Loc MachineProfileTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox Content="{loc:Loc MachineProfileEnabled}"
                                  IsChecked="{Binding Enabled}"/>
                        <TextBlock Text="{loc:Loc MachineProfileHint}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Margin="0,6,0,12"/>

                        <Grid IsEnabled="{Binding Enabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="{loc:Loc MachineMinimum}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{loc:Loc MachineMaximum}" HorizontalAlignment="Center"/>
                            <Label Grid.Row="1" Content="X, mm"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MinX, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MaxX, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Grid.Row="2" Content="Y, mm"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MinY, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MaxY, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                            <Label Grid.Row="3" Content="Z, mm"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MinZ, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Margin="4"
                                     Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding MaxZ, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                     infrastructure:NumericInput.Mode="Decimal"/>
                        </Grid>

                        <Separator Margin="0,12,0,8"/>
                        <StackPanel IsEnabled="{Binding Enabled}">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="{loc:Loc MachineMaxWorkFeed}" Width="280"/>
                                <TextBox Width="100"
                                         Style="{StaticResource MahApps.Styles.TextBox}"
                                         Text="{Binding MaxWorkFeed, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                         infrastructure:NumericInput.Mode="Decimal"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content="{loc:Loc MachineMaxRapidFeed}" Width="280"/>
                                <TextBox Width="100"
                                         Style="{StaticResource MahApps.Styles.TextBox}"
                                         Text="{Binding MaxRapidFeed, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                         infrastructure:NumericInput.Mode="Decimal"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content="{loc:Loc MachineMaxSpindleSpeed}" Width="280"/>
                                <TextBox Width="100"
                                         Style="{StaticResource MahApps.Styles.TextBox}"
                                         Text="{Binding MaxSpindleSpeedRpm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                                         infrastructure:NumericInput.Mode="Integer"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="{loc:Loc InterfaceSettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- MahApps 2.x: OnLabel/OffLabel → OnContent/OffContent, IsChecked → IsOn (two-way). -->
                        <mah:ToggleSwitch
                            Header="{loc:Loc DarkTheme}"
                            OnContent="{loc:Loc ToggleOn}"
                            OffContent="{loc:Loc ToggleOff}"
                            IsOn="{Binding UseDarkTheme}"/>

                        <TextBlock Text="{loc:Loc InterfaceLanguage}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}"
                                  Width="200"
                                  HorizontalAlignment="Left"/>

                        <!-- Единственное обращение программы к сети, поэтому
                             выключено по умолчанию, а рядом сказано, куда
                             именно она обращается. -->
                        <mah:ToggleSwitch
                            Header="{loc:Loc CheckForUpdates}"
                            OnContent="{loc:Loc ToggleOn}"
                            OffContent="{loc:Loc ToggleOff}"
                            Margin="0,16,0,0"
                            IsOn="{Binding CheckForUpdates}"/>
                        <TextBlock Text="{loc:Loc CheckForUpdatesHint}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   MaxWidth="420"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </mah:MetroTabItem>
        </mah:MetroTabControl>
    </DockPanel>
</Window>


