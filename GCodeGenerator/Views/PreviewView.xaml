<Window x:Class="GCodeGenerator.Views.PreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GCodeGenerator.ViewModels"
        xmlns:loc="clr-namespace:GCodeGenerator.Localization"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:PreviewViewModel}"
        Title="{Binding DisplayName}"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        PreviewMouseWheel="Viewport_MouseWheel"
        PreviewMouseDown="Viewport_MouseDown"
        PreviewMouseMove="Viewport_MouseMove"
        PreviewMouseUp="Viewport_MouseUp">
    <Grid x:Name="MainGrid"
          Background="Transparent"
          IsHitTestVisible="True"
          MouseDown="Viewport_MouseDown"
          MouseMove="Viewport_MouseMove"
          MouseUp="Viewport_MouseUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewport3D x:Name="Viewport"
                    Grid.Row="0"
                    IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="50,50,50" LookDirection="-1,-1,-1" UpDirection="0,0,1" 
                                   FieldOfView="45"/>
            </Viewport3D.Camera>
            
            <ModelVisual3D x:Name="LightingModel">
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <!-- Lighting -->
                        <AmbientLight Color="White" />
                        <DirectionalLight Color="White" Direction="-1,-1,-1" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Каждая плоскость — отдельная модель: переключение кнопки не
                 пересобирает тяжёлую траекторию и не сбрасывает камеру. -->
            <ModelVisual3D x:Name="GridXyVisual"/>
            <ModelVisual3D x:Name="GridXzVisual"/>
            <ModelVisual3D x:Name="GridYzVisual"/>
            
            <ModelVisual3D x:Name="TrajectoryVisual">
                <ModelVisual3D.Content>
                    <Model3DGroup/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Row="0"
                Margin="10"
                Padding="8,6"
                Panel.ZIndex="10"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}"
                BorderThickness="1"
                CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc CoordinateGrids}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ToggleButton x:Name="GridXyButton"
                              Content="XY"
                              IsChecked="{Binding ShowXyGrid}"
                              ToolTip="{loc:Loc CoordinateGridXY}"
                              MinWidth="44"
                              Padding="8,4"
                              Margin="0,0,4,0"/>
                <ToggleButton x:Name="GridXzButton"
                              Content="XZ"
                              IsChecked="{Binding ShowXzGrid}"
                              ToolTip="{loc:Loc CoordinateGridXZ}"
                              MinWidth="44"
                              Padding="8,4"
                              Margin="0,0,4,0"/>
                <ToggleButton x:Name="GridYzButton"
                              Content="YZ"
                              IsChecked="{Binding ShowYzGrid}"
                              ToolTip="{loc:Loc CoordinateGridYZ}"
                              MinWidth="44"
                              Padding="8,4"/>
            </StackPanel>
        </Border>

        <!-- Пока сцена строится, окно уже открыто: без этой надписи оно
             выглядело бы пустым и неотзывчивым. -->
        <TextBlock Text="{loc:Loc BuildingPreview}"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Opacity="0.7"
                   Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"/>

        <!-- Сцена не построена: программа при этом собрана и сохраняется,
             поэтому окно остаётся открытым, а на месте сцены стоит причина. -->
        <TextBlock Text="{Binding SceneError}"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="520"
                   Margin="24"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#E05252"
                   Visibility="{Binding HasSceneError, Converter={StaticResource BoolToVis}}"/>

        <!-- Диапазон относится только к примитивам 3D-предпросмотра и не
             меняет сгенерированную программу или очередь операций проекта. -->
        <Border x:Name="PrimitiveRangePanel"
                Grid.Row="1"
                Padding="14,8,14,10"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding HasPrimitives, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding PreviewPrimitiveRangeText}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,0,2"/>

                <mah:RangeSlider x:Name="PrimitiveRangeSlider"
                                 Grid.Row="1"
                                 Height="30"
                                 Margin="4,0"
                                 Minimum="1"
                                 Maximum="{Binding PrimitiveSliderMaximum}"
                                 LowerValue="{Binding FirstPreviewPrimitive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 UpperValue="{Binding LastPreviewPrimitive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinRange="0"
                                 Interval="1"
                                 TickFrequency="1"
                                 IsSnapToTickEnabled="True"
                                 IsMoveToPointEnabled="True"
                                 MoveWholeRange="False"
                                 IsSelectionRangeEnabled="True"
                                 AutoToolTipPlacement="TopLeft"
                                 AutoToolTipPrecision="0"
                                 IsEnabled="{Binding HasMultiplePrimitives}"
                                 AutomationProperties.Name="{loc:Loc PreviewPrimitiveRange}"/>

                <Grid Grid.Row="2" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FirstPreviewPrimitiveText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FirstPreviewPrimitiveText}"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding LastPreviewPrimitiveText}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right"
                               ToolTip="{Binding LastPreviewPrimitiveText}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
