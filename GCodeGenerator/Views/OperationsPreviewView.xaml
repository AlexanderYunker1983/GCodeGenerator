<UserControl x:Class="GCodeGenerator.Views.OperationsPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="220">
    <!-- Пункт 1.4: 1.x-ключи TextBoxBorderBrush/ControlBackgroundBrush → 2.x-аналоги из темы MahApps. -->
    <Border BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}"
            BorderThickness="1"
            Background="{DynamicResource MahApps.Brushes.Control.Background}">
        <Grid>
            <Canvas x:Name="PreviewCanvas"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    ClipToBounds="True"
                    MouseWheel="PreviewCanvas_OnMouseWheel"
                    MouseDown="PreviewCanvas_OnMouseDown"
                    MouseMove="PreviewCanvas_OnMouseMove"
                    MouseUp="PreviewCanvas_OnMouseUp"
                    MouseLeave="PreviewCanvas_OnMouseLeave"
                    PreviewMouseLeftButtonDown="PreviewCanvas_OnMouseLeftButtonDown"
                    SizeChanged="PreviewCanvas_OnSizeChanged"/>

            <!-- Контуры показывают замысел, траектория — то, что проделает
                 станок. Переключатель доступен, когда программа построена. -->
            <!-- Обе команды принадлежат одному верхнему блоку. Раньше
                 «Показать всё» размещалась поверх UserControl из MainView
                 и при длинной локализации перекрывала этот флажок. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,10,0">
                <CheckBox Content="{loc:Loc ShowToolPath}"
                          IsChecked="{Binding ShowToolPath}"
                          IsEnabled="{Binding HasToolPath}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                <Button Content="{loc:Loc ShowAll}"
                        Command="{Binding ShowAllCommand}"
                        Padding="7,5"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
