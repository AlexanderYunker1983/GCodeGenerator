<Window x:Class="GCodeGenerator.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GCodeGenerator.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GCodeGenerator.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:AboutViewModel}"
        Title="{loc:Loc AboutTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <Button DockPanel.Dock="Right"
                    Content="{loc:Loc Close}"
                    Command="{Binding CloseCommand}"
                    IsDefault="True" IsCancel="True"
                    MinWidth="90"/>
            <TextBlock/>
        </DockPanel>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource NewFileImage}" Width="40" Height="40"
                       VerticalAlignment="Top" Margin="0,0,14,0"/>
                <StackPanel>
                    <TextBlock Text="{loc:Loc MainTitle}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,2,0,0">
                        <Run Text="{loc:Loc AboutVersion}"/>
                        <Run Text="{Binding Version, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Copyright, Mode=OneWay}" Margin="0,2,0,0" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{loc:Loc AboutDescription}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <TextBlock Text="{loc:Loc AboutLicense}" Margin="0,12,0,0" Opacity="0.85"/>

            <!-- Страница продукта: отсюда берут новые версии и сюда пишут о проблемах. -->
            <TextBlock Margin="0,12,0,0">
                <Hyperlink Command="{Binding OpenRepositoryCommand}">
                    <Run Text="{Binding Repository, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>

            <!-- Журнал работы: его просят приложить к сообщению о сбое, поэтому
                 путь показан целиком и открывается одной кнопкой. -->
            <TextBlock Text="{loc:Loc AboutLogFile}" Margin="0,16,0,0" FontWeight="SemiBold"/>
            <TextBox Text="{Binding LogFilePath, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Margin="0,2,0,0"/>
            <Button Content="{loc:Loc AboutShowLog}"
                    Command="{Binding ShowLogCommand}"
                    HorizontalAlignment="Left" MinWidth="150" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
