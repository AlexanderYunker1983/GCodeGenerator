<Window x:Class="GCodeGenerator.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GCodeGenerator.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GCodeGenerator.ViewModels"
        xmlns:views="clr-namespace:GCodeGenerator.Views"
        xmlns:drillViews="clr-namespace:GCodeGenerator.Views.Drill"
        xmlns:pocketMillViews="clr-namespace:GCodeGenerator.Views.PocketMill"
        xmlns:pocketViews="clr-namespace:GCodeGenerator.Views.Pocket"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        Title="{Binding DisplayName}"
        Height="600" Width="1200"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
    <!-- Клавиши работы с документом — те же, что в любой программе с файлами:
         человек нажимает Ctrl+S не задумываясь. Прежде здесь были только
         отмена и повтор, а сохранение и открытие требовали мыши. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding ProjectWorkflow.NewProgramCommand}"/>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding ProjectWorkflow.OpenProjectCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding ProjectWorkflow.SaveProjectCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding ProjectWorkflow.SaveProjectAsCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding OperationsWorkspace.UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding OperationsWorkspace.RedoCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenAboutCommand}"/>
    </Window.InputBindings>
    <Grid Margin="8">
        <!--
            Все три колонки пропорциональные, с собственным наименьшим
            размером. Прежде средняя и правая имели постоянную ширину, и при
            сжатии окна ужималась одна левая: до нуля, потому что забирала
            остаток. Поэтому окно и не разрешало себя уменьшить — наименьшая
            ширина 1200 не помещалась на экране 1920×1080 при масштабе 175 %,
            где рабочая область всего 1097 единиц.

            Доли подобраны так, чтобы при обычной ширине колонки сохранили
            привычные размеры (примерно 436, 349 и 392 при 1200). Наименьшие
            размеры — по содержимому: две плитки в выборе операций, три кнопки
            над списком, обе кнопки G-кода.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="0.8*" MinWidth="264" />
            <ColumnDefinition Width="0.9*" MinWidth="316" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,3,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Подсказки называют и клавишу: иначе о ней узнают, только
                 прочитав документацию, а кнопки создания и открытия до этого
                 не подписывались вовсе. -->
            <Button Grid.Column="0" Padding="3" Margin="0,0,3,0"
                    Command="{Binding ProjectWorkflow.NewProgramCommand}"
                    ToolTip="{loc:Loc NewProjectToolTip}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Image Source="{StaticResource NewFileImage}" Width="24" Height="24"/>
            </Button>

            <Button Grid.Column="1" Padding="3" Margin="0,0,3,0"
                    Command="{Binding ProjectWorkflow.OpenProjectCommand}"
                    ToolTip="{loc:Loc OpenProjectToolTip}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Image Source="{StaticResource OpenFileImage}" Width="24" Height="24"/>
            </Button>

            <Button Grid.Column="2" Padding="3" Margin="0,0,3,0"
                    Command="{Binding ProjectWorkflow.SaveProjectCommand}"
                    ToolTip="{loc:Loc SaveProjectToolTip}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowOnDisabled="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Image Source="{StaticResource SaveFileImage}" Width="24" Height="24"/>
            </Button>

            <!-- Сохранение в другой файл: обычное «Сохранить» после первого
                 раза пишет в тот же файл без вопросов. -->
            <Button Grid.Column="3" Padding="3" Margin="0,0,3,0"
                    Command="{Binding ProjectWorkflow.SaveProjectAsCommand}"
                    Content="{loc:Loc SaveProjectAs}"
                    ToolTip="{loc:Loc SaveProjectAsToolTip}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowOnDisabled="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>

            <!-- Вышла новая версия. Строка появляется только после проверки,
                 которую человек включил сам, и работать не мешает: она стоит
                 в свободной колонке панели и по нажатию открывает страницу
                 выпуска. -->
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="8,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding UpdateNotice}"
                       Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                <Hyperlink Command="{Binding OpenUpdatePageCommand}">
                    <Run Text="{Binding UpdateNotice, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <!-- Знак вопроса лежит в такой же клетке 24×24, как значки
                     остальных кнопок панели: сам по себе он занимает высоту
                     строки текста, и кнопка выходила ниже соседней. -->
                <Button x:Name="AboutButton"
                        Command="{Binding OpenAboutCommand}"
                        Padding="3" Margin="0,0,3,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="{loc:Loc AboutToolTip}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="0">
                    <Grid Width="24" Height="24">
                        <TextBlock Text="?" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="SettingsButton"
                        Command="{Binding OpenSettingsCommand}"
                        Padding="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="{loc:Loc Settings}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowOnDisabled="True">
                    <Image Source="{StaticResource SettingsImage}" Width="24" Height="24"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Left side: operation type selector inside TabControl -->
        <mah:MetroTabControl Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,8,0">
            <!-- MahApps 2.x: mah:MetroTabItem вместо TabItem (стиль MetroTabItem типизирован под MetroTabItem). -->
            <mah:MetroTabItem Header="{loc:Loc DrillingTab}">
                <drillViews:DrillOperationsView DataContext="{Binding OperationsWorkspace.DrillOperations}"/>
            </mah:MetroTabItem>
            <mah:MetroTabItem Header="{loc:Loc ProfileTab}">
                <pocketMillViews:ProfileMillingOperationsView DataContext="{Binding OperationsWorkspace.ProfileMillingOperations}"/>
            </mah:MetroTabItem>
            <mah:MetroTabItem Header="{loc:Loc PocketTab}">
                <pocketViews:PocketOperationsView DataContext="{Binding OperationsWorkspace.PocketOperations}"/>
            </mah:MetroTabItem>
        </mah:MetroTabControl>

        <!-- Top-right: operations list controls + generate & settings -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button VerticalAlignment="Center" Grid.Column="0"
                    Command="{Binding OperationsWorkspace.MoveOperationUpCommand}" Width="80" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource UpImage}" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc MoveUp}"/>
                </StackPanel>
            </Button>
            <Button VerticalAlignment="Center" Grid.Column="1"
                    Command="{Binding OperationsWorkspace.MoveOperationDownCommand}" Width="80">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource DownImage}" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc MoveDown}"/>
                </StackPanel>
            </Button>
            <Button VerticalAlignment="Center"
                    Grid.Column="3" Margin="0,0,6,0"
                    Command="{Binding OperationsWorkspace.RemoveOperationCommand}" Width="80">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource DeleteImage}" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc DeleteOperation}"/>
                </StackPanel>
            </Button>
            
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{loc:Loc GenerateGCode}" VerticalAlignment="Center"
                    Command="{Binding GCodeWorkflow.GenerateGCodeCommand}" Width="160"/>
            <!-- Ход генерации и её остановка: видны только пока программа
                 строится. Кнопка узкая и скрыта в остальное время, поэтому
                 места у полосы хода не отнимает. -->
            <Grid Grid.Column="1" Margin="8,0"
                  Visibility="{Binding GCodeWorkflow.IsGenerating, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                             Value="{Binding GCodeWorkflow.ProgressPercent, Mode=OneWay}"
                             Height="16" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="6,1" MinWidth="28"
                        Content="✕"
                        Command="{Binding GCodeWorkflow.CancelGenerationCommand}"
                        ToolTip="{loc:Loc CancelGeneration}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="0"
                        VerticalAlignment="Center"/>
            </Grid>
            <Button Grid.Column="2" Content="{loc:Loc SaveGCode}" VerticalAlignment="Center"
                    Command="{Binding GCodeWorkflow.SaveGCodeCommand}"  Width="140"/>

        </Grid>
        <!-- Middle: operations list with fixed width -->
        <GroupBox Header="{loc:Loc OperationsHeader}"
                  Grid.Row="2" Grid.Column="1" Margin="0,0,4,0">
            <ListBox x:Name="OperationsList"
                     ItemsSource="{Binding OperationsWorkspace.AllOperations}"
                     SelectedItem="{Binding OperationsWorkspace.SelectedOperation, Mode=TwoWay}"
                     MouseDoubleClick="OperationsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsEnabled}"
                                      Content="{loc:Loc OperationEnabled}"/>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Right: G-code preview with initial width ~250 and resizable -->
        <GroupBox Header="{loc:Loc GCodePreviewHeader}"
                  Grid.Row="2" Grid.Column="2">
            <!-- Программа показывается виртуализированным списком строк:
                 поле ввода держало весь текст одной строкой и на сотне тысяч
                 строк замирало при каждой генерации. -->
            <ListBox x:Name="GCodePreviewList"
                     ItemsSource="{Binding GCodeWorkflow.ProgramLines}"
                     FontFamily="Consolas"
                     Background="{DynamicResource MahApps.Brushes.Control.Background}"
                     Foreground="{DynamicResource MahApps.Brushes.Text}"
                     BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}"
                     BorderThickness="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item">
                <ListBox.ItemContainerStyle>
                    <!-- Плотные строки, как в текстовом поле: без отступов темы. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>

        <GridSplitter Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="2"
                      Background="Gray" Margin="0,2,0,2"/>
        <!-- Bottom: 2D preview of operations -->
        <!-- Пункт 6.3 плана: DataContext — OperationsPreviewViewModel (чистая OperationScene). -->
        <views:OperationsPreviewView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" DataContext="{Binding OperationsWorkspace.OperationsPreview}"/>

        <!-- Preview button above TabControl -->
        <Button Command="{Binding GCodeWorkflow.PreviewGCodeCommand}"
                Grid.Row="4" Grid.Column="0" TabIndex="100"
                Margin="11,18,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="7,5"
                ToolTip="{loc:Loc PreviewGCode}"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.ShowOnDisabled="True">
            <Grid>
                <Image Source="{StaticResource View3DImage}" Width="48" Height="48"/>
                <Label Content="3D" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="22"/>
            </Grid>
        </Button>

    </Grid>
</Window>
