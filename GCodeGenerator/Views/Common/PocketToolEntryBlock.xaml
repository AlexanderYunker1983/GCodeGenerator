<UserControl x:Class="GCodeGenerator.Views.Common.PocketToolEntryBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:GCodeGenerator.Infrastructure"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization"
             xmlns:models="clr-namespace:GCodeGenerator.Models;assembly=GCodeGenerator.Core">
    <GroupBox Header="{loc:Loc ToolEntryHeader}" Margin="0,0,0,8">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <RadioButton Content="{loc:Loc EntryModeVertical}"
                             GroupName="PocketEntryMode"
                             IsChecked="{Binding Operation.EntryMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PocketEntryMode.Vertical}}"
                             Margin="0,0,0,4"/>
                <RadioButton Content="{loc:Loc EntryModeHelical}"
                             GroupName="PocketEntryMode"
                             IsChecked="{Binding Operation.EntryMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PocketEntryMode.Helical}}"/>
            </StackPanel>

            <!-- Угол и диаметр относятся только к винтовому входу. -->
            <Grid Grid.Row="1" IsEnabled="{Binding IsHelicalEntry}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc EntryAngleDeg}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Operation.EntryAngle, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                         infrastructure:NumericInput.Mode="Decimal"
                         Margin="0,0,4,0"/>
                <TextBlock Grid.Column="3"
                           Text="{loc:Loc HelicalEntryDiameter}"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding Operation.HelicalEntryDiameter, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}"
                         infrastructure:NumericInput.Mode="Decimal"/>
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
