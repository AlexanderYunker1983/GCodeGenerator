<UserControl x:Class="GCodeGenerator.Views.Common.MillingPositioningBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:GCodeGenerator.Infrastructure"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization">
    <GroupBox Header="{loc:Loc PositioningHeader}" Margin="0,0,0,8">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ContourHeightZ}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Operation.ContourHeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="3" Text="{loc:Loc Decimals}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Grid.Column="4" Text="{Binding Operation.Decimals, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Integer"/>
        </Grid>
    </GroupBox>
</UserControl>
