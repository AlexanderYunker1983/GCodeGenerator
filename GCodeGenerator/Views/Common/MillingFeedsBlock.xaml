<UserControl x:Class="GCodeGenerator.Views.Common.MillingFeedsBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:GCodeGenerator.Infrastructure"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization">
    <GroupBox Header="{loc:Loc FeedParametersHeader}" Margin="0,0,0,8">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc FeedXYRapid}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FeedXYRapid, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal" Margin="0,0,4,0"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Loc FeedXYWork}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding FeedXYWork, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc FeedZRapid}" VerticalAlignment="Center" Margin="0,8,4,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FeedZRapid, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal" Margin="0,8,4,0"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{loc:Loc FeedZWork}" VerticalAlignment="Center" Margin="8,8,4,0"/>
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding FeedZWork, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal" Margin="0,8,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>
