<UserControl x:Class="GCodeGenerator.Views.Common.DialogButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization">
    <!-- OK сохраняет изменения, отмена закрывает окно без них.
         Неверные параметры окно не закрывают: слева от кнопок появляется
         пояснение, а операция остаётся такой, какой была. -->
    <DockPanel LastChildFill="True" Margin="10,8,10,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Ok}" Command="{Binding OkCommand}" IsDefault="True" TabIndex="1000" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" IsCancel="True" TabIndex="1001" MinWidth="80"/>
        </StackPanel>
        <!-- Цвет подобран так, чтобы читаться и на светлой, и на тёмной теме:
             кисти тем MahApps для сообщений об ошибке различаются между версиями,
             а строка обязана быть заметной в обеих. -->
        <TextBlock Foreground="#E05252"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   ToolTip="{Binding ValidationSummary}"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
            <Run Text="{loc:Loc OperationParametersInvalid}"/>
            <LineBreak/>
            <!-- Перечень проблем: какое поле и что с ним не так. Прежде
                 окно сообщало лишь о самом факте, и виновное поле
                 приходилось искать самому. -->
            <Run Text="{Binding ValidationSummary, Mode=OneWay}"/>
        </TextBlock>
    </DockPanel>
</UserControl>
