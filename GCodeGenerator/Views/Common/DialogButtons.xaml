<UserControl x:Class="GCodeGenerator.Views.Common.DialogButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization">
    <!-- OK сохраняет изменения, отмена закрывает окно без них.
         Неверные параметры окно не закрывают: слева от кнопок появляется
         пояснение, а операция остаётся такой, какой была. -->
    <DockPanel LastChildFill="True" Margin="10,8,10,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Ok}" Command="{Binding OkCommand}" IsDefault="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
        </StackPanel>
        <!-- Цвет подобран так, чтобы читаться и на светлой, и на тёмной теме:
             кисти тем MahApps для сообщений об ошибке различаются между версиями,
             а строка обязана быть заметной в обеих. -->
        <TextBlock Text="{loc:Loc OperationParametersInvalid}"
                   Foreground="#E05252"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}"/>
    </DockPanel>
</UserControl>
