<UserControl x:Class="GCodeGenerator.Views.Common.MillingHeightsBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization">
    <GroupBox Header="{loc:Loc ZHeightsHeader}" Margin="0,0,0,8">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc SafeZHeight}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding SafeZHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="3" Text="{loc:Loc RetractZHeight}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Grid.Column="4" Text="{Binding RetractHeight, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </GroupBox>
</UserControl>
