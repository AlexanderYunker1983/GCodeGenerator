<UserControl x:Class="GCodeGenerator.Views.Common.PocketProcessingDirectionBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization"
             xmlns:models="clr-namespace:GCodeGenerator.Models;assembly=GCodeGenerator.Core"
             Visibility="{Binding IsSpiralOrConcentricStrategy, Converter={StaticResource BoolToVis}}">
    <GroupBox Header="{loc:Loc PocketProcessingDirectionHeader}" Margin="0,0,0,8">
        <StackPanel Margin="8">
            <RadioButton Content="{loc:Loc PocketProcessingDirectionCenterOutward}"
                         GroupName="PocketProcessingDirection"
                         IsChecked="{Binding Operation.ProcessingDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PocketProcessingDirection.CenterOutward}}"
                         Margin="0,0,0,4"/>
            <RadioButton Content="{loc:Loc PocketProcessingDirectionOutsideIn}"
                         GroupName="PocketProcessingDirection"
                         IsChecked="{Binding Operation.ProcessingDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PocketProcessingDirection.OutsideIn}}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
