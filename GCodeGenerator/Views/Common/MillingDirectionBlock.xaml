<UserControl x:Class="GCodeGenerator.Views.Common.MillingDirectionBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GCodeGenerator.Localization"
             xmlns:models="clr-namespace:GCodeGenerator.Models;assembly=GCodeGenerator.Core">
    <GroupBox Header="{loc:Loc DirectionHeader}" Margin="0,0,0,8">
        <StackPanel Margin="8">
            <RadioButton Content="{loc:Loc DirectionClockwise}" GroupName="Direction"
                         IsChecked="{Binding Direction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:MillingDirection.Clockwise}}"
                         Margin="0,0,0,4"/>
            <RadioButton Content="{loc:Loc DirectionCounterClockwise}" GroupName="Direction"
                         IsChecked="{Binding Direction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:MillingDirection.CounterClockwise}}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
