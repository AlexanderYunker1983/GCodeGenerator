<Window x:Class="GCodeGenerator.Views.Drill.DrillPointsOperationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:GCodeGenerator.Infrastructure"
        xmlns:loc="clr-namespace:GCodeGenerator.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GCodeGenerator.ViewModels.Drill"
        xmlns:common="clr-namespace:GCodeGenerator.Views.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:DrillPointsOperationViewModel}"
        Title="{Binding DisplayName}"
        Width="1000" Height="600"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <common:DialogButtons DockPanel.Dock="Bottom"/>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Global settings -->
        <GroupBox Header="{loc:Loc GeneralParametersHeader}" Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,4"
                           Text="{loc:Loc FeedXYRapid}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,4,4" Width="80"
                         Text="{Binding Operation.FeedXYRapid, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,4,4"
                           Text="{loc:Loc FeedXYWork}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="4" Margin="0,0,4,4" Width="80"
                         Text="{Binding Operation.FeedXYWork, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,4,0"
                           Text="{loc:Loc SafeZBetweenHolesLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,4,0" Width="80"
                         Text="{Binding Operation.SafeZBetweenHoles, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Decimal"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,4,4,0"
                           Text="{loc:Loc Decimals}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,4,4,0" Width="60"
                         Text="{Binding Operation.Decimals, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" infrastructure:NumericInput.Mode="Integer"/>
            </Grid>
        </GroupBox>

        <!-- Holes list -->
        <GroupBox Header="{loc:Loc HolesHeader}" Grid.Row="1">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                    <Button Content="{loc:Loc Add}" Command="{Binding AddHoleCommand}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Remove}" Command="{Binding RemoveHoleCommand}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Up}" Command="{Binding MoveHoleUpCommand}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Down}" Command="{Binding MoveHoleDownCommand}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Operation.Holes}"
                          SelectedItem="{Binding SelectedHole, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          Margin="0,4,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc CoordinateX}" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc CoordinateY}" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc StartZ}" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Depth}" Binding="{Binding TotalDepth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Step}" Binding="{Binding StepDepth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc FeedZRapidLabel}" Binding="{Binding FeedZRapid, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc FeedZWorkLabel}" Binding="{Binding FeedZWork, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc RetractHeight}" Binding="{Binding RetractHeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericText}}" EditingElementStyle="{StaticResource NumericCellEditor}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
    </DockPanel>
</Window>


