<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style (пункт 1.1 плана); TFM net10.0-windows (пункт 1.5 плана, D5).
    - UseWPF: App.xaml → ApplicationDefinition, остальные .xaml → Page (как в старом csproj).
    - Version: из git-тега при сборке (Directory.Build.targets + build/Get-GitVersion.ps1);
      SDK генерирует AssemblyVersion/FileVersion/InformationalVersion, прочие атрибуты
      (ThemeInfo, InternalsVisibleTo и т.п.) — вручную в Properties/AssemblyInfo.cs.
    - LangVersion=latest: как до миграции (в старом csproj LangVersion не задан —
      использовался дефолт компилятора).
    - App.config убран (пункт 1.5): содержал только <startup> и binding redirects —
      оба не применяются на .NET 10.
    - System.Configuration.ConfigurationManager и System.Text.Json как пакеты
      НЕ нужны (пункт 1.5): в .NET 10 оба входят в shared framework
      (System.Configuration.ConfigurationManager.dll — в Microsoft.WindowsDesktop.App,
      System.Text.Json.dll — в Microsoft.NETCore.App; warning NU1510 подтверждает).
      Properties.Settings (ApplicationSettingsBase) работает из коробки;
      STJ — версия 10.x из рантайма (формат .ygc проверен тестами 1.2).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GCodeGenerator</RootNamespace>
    <AssemblyName>GCodeGenerator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- GenerateTargetPlatformAttribute/GenerateSupportedOSPlatformAttribute=false:
         SDK для net10.0-windows генерирует [assembly: SupportedOSPlatform("Windows7.0")],
         а в Tests (ручной AssemblyInfo.cs, GenerateAssemblyInfo=false) такого атрибута нет —
         рассогласование вызвало 223 предупреждения CA1416 в Tests на вызовах типов App
         (та же причина, что и в Core, см. его csproj). -->
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <ApplicationIcon>cnc_machine.ico</ApplicationIcon>
    <!-- Классическая раскладка bin\Release (без подпапки TFM): CI и документация
         ссылаются на bin\Release\GCodeGenerator.exe -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Фаза 2 плана (пункт 2.2): ядро (Models, GCodeGenerators, базовая локализация)
         вынесено в GCodeGenerator.Core — неймспейсы сохранены, код App не менялся. -->
    <ProjectReference Include="..\GCodeGenerator.Core\GCodeGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.2" />
    <!-- Пункт 1.4: MahApps.Metro 2.x + ControlzEx 4.x + Behaviors 1.1.142.
         MahApps 2.x нет в локальном зеркале — берётся с nuget.org (см. NuGet.config в корне). -->
    <PackageReference Include="ControlzEx" Version="4.4.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <!-- Пункт 1.3: MVVM-фреймворк (замена MugenMvvmToolkit). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка как WPF-ресурс (как в старом csproj) + иконка exe -->
    <Resource Include="cnc_machine.ico" />
  </ItemGroup>

</Project>
