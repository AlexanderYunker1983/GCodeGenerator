<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!--
    Манифест приложения.

    Без него Windows считает программу написанной до Windows Vista и включает
    для неё режим совместимости: система сообщает о себе версией 6.2 и может
    подменять поведение отдельных функций. Объявление поддерживаемых версий
    снимает это предположение.

    Осведомлённость о масштабе экрана объявлена явно, хотя WPF на .NET и так
    работает в режиме «на монитор, версия 2»: в манифесте это видно, а окно
    продукта минимальным размером упирается именно в масштаб — на экране
    1920×1080 при 175 % рабочая область составляет 1097 единиц.
  -->
  <assemblyIdentity version="1.0.0.0" name="GCodeGenerator.app" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 и Windows 11 (один и тот же идентификатор). -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <!-- Кодировка строк процесса: пути к проектам и чертежам могут содержать
           любые символы, а не только буквы кодовой страницы системы. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
