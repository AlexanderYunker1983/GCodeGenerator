<Project>
  <!--
    Запоминаем, задавал ли пользователь Version ЯВЛЬНО (командная строка
    /p:Version=...): в props-фазе $(Version) ещё пуст — дефолт SDK (1.0.0)
    проставляется позже, в targets-фазе (Microsoft.NET.Sdk.BeforeCommon.targets),
    а Directory.Build.targets импортируется ещё позже (Microsoft.Common.targets).
    Потребитель: Directory.Build.targets (версионирование из git-тегов).
  -->
  <PropertyGroup>
    <_GitVersionExplicit Condition="'$(Version)' != ''">true</_GitVersionExplicit>
  </PropertyGroup>

  <!--
    Единые настройки анализа кода для всех проектов решения.

    - TreatWarningsAsErrors: локальная сборка так же строга, как CI
      (шаг «Build (Release)» вызывает msbuild с -warnaserror). Предупреждение,
      незамеченное на машине разработчика, роняло сборку только в CI.
    - WarningLevel 9: уровень по умолчанию для C# на .NET 10; в проектах был
      явно зафиксирован устаревший уровень 4.
    - EnableNETAnalyzers + AnalysisLevel latest: анализаторы .NET в режиме
      Default (нарушений в коде нет). Более строгие режимы (Recommended/All)
      дают более тысячи стилевых замечаний и включаются отдельным шагом.
    - EnforceCodeStyleInBuild + GenerateDocumentationFile: включают в сборку
      правила стиля, в первую очередь IDE0005 («ненужный using»), которое
      без файла документации молча не работает (dotnet/roslyn#41640).
      Побочный эффект файла документации — проверка XML-комментариев:
      незакрытые теги, ссылки cref на удалённые типы и параметры, которых
      больше нет в сигнатуре.
    - NoWarn CS1591: документировать каждый публичный член не требуется;
      проверяются только корректность и актуальность имеющихся комментариев.
    - Nullable на уровне проекта не включается: сразу это дало бы около 950
      предупреждений. Проверка включается пофайлово директивой
      #nullable enable; пройдены модели ядра и генераторы — через модели
      пустота расходится по остальному коду, а в генераторах доходит до
      построения траектории. Дальше — приложение.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9</WarningLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Файл документации нужен только компилятору (без него не работает
         IDE0005). В дистрибутив он попадать не должен: publish-каталог целиком
         уходит в инсталлятор и в портативный архив. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!--
    Точный состав зависимостей фиксируется файлом packages.lock.json рядом
    с каждым проектом. Версии в csproj задают только прямые ссылки, а что
    именно приедет транзитивно — решал восстановитель пакетов в момент
    сборки: тот же коммит на другой машине или через полгода мог собраться
    с другим набором. Замок перечисляет всё дерево вместе с контрольными
    суммами, а рабочие процессы восстанавливают пакеты в закреплённом режиме
    (ключ locked-mode), где расхождение с замком — отказ, а не молчаливое
    обновление.

    Обновление пакета: поменять версию в csproj и восстановить пакеты
    с ключом force-evaluate — замок пересоберётся и попадёт в тот же
    коммит, что и само обновление.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
